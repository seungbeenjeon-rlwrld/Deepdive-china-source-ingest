# Copy to .env and fill in.  .env is gitignored — never commit it.
#
# ============================================================
# LLM: the default provider needs NO key
# ============================================================
# `provider: claude-cli` (the default in config.yaml) uses the local Claude
# Code CLI and its existing authentication, so there is nothing to put here.
#   curl -fsSL https://claude.ai/install.sh | bash
#   claude --version
#
# It shares your interactive Claude Code usage allowance. For large scheduled
# batches, switch to `provider: zhipu` below.
#
# Optional overrides:
# CLAUDE_CLI_BINARY=claude
# CLAUDE_CLI_MODEL=
#
# ============================================================
# Option A — Z.ai (Zhipu / 智谱)   ... provider: zhipu
# ============================================================
# Works with a plain EMAIL registration — no Chinese ID needed.
# Create a key at https://z.ai/model-api
#
# This is the right option unless you have a China-site Tencent Cloud
# account. Note: the international platform does not expose the 搜狗
# (WeChat) search engine, so WeChat coverage is narrower than Yuanbao's.

ZHIPU_API_KEY=

# Optional overrides for config.yaml
# ZHIPU_MODEL=glm-4.7-flash
# ZHIPU_BASE_URL=https://api.z.ai/api/paas/v4


# ============================================================
# Baidu index via SerpApi      ... search_sweep.provider: serpapi
# ============================================================
# Email signup, no Chinese account, 100 free searches/month.
#   https://serpapi.com/users/sign_up  ->  https://serpapi.com/manage-api-key
#
# Search-only: it cannot run the research prompts, so pair it with a chat
# provider above. Baidu retired its official search API, so this is a vendor
# running the query and parsing Baidu's result page — not a first-party API.

SERPAPI_KEY=


# ============================================================
# Option B — Tencent Cloud        ... provider: tencent
# ============================================================
# Best WeChat / Tencent-ecosystem coverage, but REQUIRES a China-site
# account, and China-site real-name verification accepts only a mainland
# Chinese ID card, an HK/Macau/Taiwan travel permit, or a Chinese business
# licence. A foreign passport is not accepted — passport holders are sent
# to the international site, which does not sell 联网搜索API at all.
#
# Create keys at: https://console.cloud.tencent.com/cam/capi
#
# Activate both products first (both are pay-per-use and reject calls
# until activated):
#   - 腾讯混元大模型 (Hunyuan)   https://console.cloud.tencent.com/hunyuan/settings
#   - 联网搜索API (Web Search)   https://console.cloud.tencent.com/wsapi/index
#     ^ click 开通服务 and pick a tier. 标准版 is the sensible default;
#       尊享版/旗舰版 are enterprise-only.
#
# Keys must be created on the MASTER account. Also note: Tencent Cloud
# auto-disables AccessKeys unused for 90 days, which bites an
# occasionally-run tool like this one.

TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# Region for the Hunyuan endpoint. 联网搜索API ignores it.
TENCENT_REGION=ap-guangzhou

# Optional: must be a model with search-enhancement support — NOT hunyuan-lite.
TENCENT_MODEL=hunyuan-turbos-latest
